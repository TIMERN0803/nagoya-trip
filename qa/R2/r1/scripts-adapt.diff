+
+# ===== R2 批 1 轉接層（2026-10-29，只在工作複本，不進 repo）=====
+# v44 之後介面改了：記帳表單搬進「記一筆」面板（10/27）、清單改成待辦／要買的分頁（10/26）、
+# 求助面板改版（3A）。腳本照舊寫舊選擇器，這裡在用到時先做「人會做的那一步」：打開記一筆、切到對應分頁。
+# 只補「找得到元素」，不改判斷。依賴這層的結果在 REPORT 標註。
+from playwright.async_api import Page as _P
+_EXP = ('#f-amt', '#f-save', '#f-note', '#f-msg', '[data-pick=', '[data-tf-toggle]', '#f-tf', '#f-date')
+ADAPT = {"exp": 0, "tab": 0, "sos": 0, "msg": 0}
+async def _prep(pg, sel):
+    if not isinstance(sel, str): return sel
+    s = sel.replace('.sos [data-sos-show', '[data-sos-show')
+    if s != sel:
+        ADAPT["sos"] += 1; s = s + ' >> visible=true'
+    if s.startswith('#f-msg'):
+        if not await _orig_qs(pg, '.exp-sheet:not(.leaving) #f-msg'):
+            ADAPT["msg"] += 1; s = '#acct-note'
+        else: s = '.exp-sheet:not(.leaving) ' + s
+    elif s.startswith(_EXP) or any(k in s for k in _EXP[:3]):
+        try:
+            if not await _orig_qs(pg, '.exp-sheet:not(.leaving) #f-amt') and await _orig_qs(pg, '[data-exp-new]'):
+                ADAPT["exp"] += 1; await _orig_click(pg, '[data-exp-new]'); await pg.wait_for_timeout(650)
+        except Exception: pass
+        if s.startswith('#f-'): s = '.exp-sheet:not(.leaving) ' + s
+    for g in ('buy', 'prep'):
+        if f'data-item-new="{g}"' in s and not await _orig_qs(pg, s) and await _orig_qs(pg, f'[data-list-tab="{g}"]'):
+            ADAPT["tab"] += 1; await _orig_click(pg, f'[data-list-tab="{g}"]'); await pg.wait_for_timeout(300)
+    return s
+_orig_qs, _orig_click = _P.query_selector, _P.click
+def _wrap(name):
+    orig = getattr(_P, name)
+    async def w(self, selector, *a, **k):
+        return await orig(self, await _prep(self, selector), *a, **k)
+    setattr(_P, name, w)
+for _n in ('fill', 'click', 'focus', 'type', 'press', 'input_value', 'inner_text', 'is_visible', 'wait_for_selector', 'query_selector', 'check', 'dispatch_event', 'text_content'):
+    _wrap(_n)
+_orig_eval = _P.evaluate
+async def _eval(self, expr, *a, **k):
+    if isinstance(expr, str) and ('"f-save"' in expr or '"f-amt"' in expr or "#f-amt" in expr or '"f-day"' in expr or 'data-pick' in expr) and '"f-msg").innerText.includes' not in expr:
+        await _prep(self, '#f-amt')
+    return await _orig_eval(self, expr, *a, **k)
+_P.evaluate = _eval
+import atexit as _ax
+_ax.register(lambda: print("ADAPT", json.dumps(ADAPT), flush=True))
